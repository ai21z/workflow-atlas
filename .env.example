# Optional local JEV setup. Manual workflow creation works with this empty.
# Copy this file to .env.local on your own machine, then add your own key there.
# Obtain a key from https://console.typesafe.ai/ and keep it private.
# Never put a real key in this example, public files, screenshots or artifact packs.
TYPESAFE_API_KEY=

# Node.js 22 or newer. Run from the repository folder:
# node --env-file=.env.local tools/serve.mjs
# For another local port:
# node --env-file=.env.local tools/serve.mjs --port 8781
# Environment variables already set in the shell take precedence over this file.
# This server does not load environment files unless --env-file is supplied to Node.
# .env.local is ignored by Git and denied by the local web server.
# It still stores the key on disk. Hidden terminal input is an alternative.
# See docs/jev/integration.md for setup and recovery steps.

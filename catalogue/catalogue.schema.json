                    },
                    "uniqueItems": true
                  },
                  "atlasTopic": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                }
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "confidenceLevel": {
                "enum": [

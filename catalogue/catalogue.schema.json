{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai21z.github.io/workflow-atlas/catalogue.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "topics",
    "definitions",
    "sources",
    "actions",
    "navigation",
    "relations"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "version",
        "projectSchemaVersion",
        "reviewedOn",
        "topicOrder",
        "sourceAliases",
        "toolAliases",
        "factStatuses",
        "evidenceStatuses",
        "controlStatuses"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.2"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "projectSchemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "reviewedOn": {
          "type": "string",
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "topicOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "sourceAliases": {
          "type": "object",
          "required": [
            "agents",
            "install",
            "skills",
            "copilotSkills"
          ],
          "properties": {
            "agents": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "install": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "skills": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "copilotSkills": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "toolAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "factStatuses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "evidenceStatuses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "controlStatuses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "sections",
          "refs",
          "basis",
          "confidence",
          "catalog"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "label",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "p",
                        "code"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "label",
                    "items"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "list",
                        "steps"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "label",
                    "headers",
                    "rows"
                  ],
                  "properties": {
                    "type": {
                      "const": "table"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "cellLinks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["row", "column", "label"],
                        "properties": {
                          "row": { "type": "integer", "minimum": 0 },
                          "column": { "type": "integer", "minimum": 0 },
                          "label": { "type": "string", "minLength": 1 },
                          "href": { "type": "string", "pattern": "^https://" },
                          "sourceRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                          "topicId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                        },
                        "oneOf": [
                          { "properties": { "href": {} }, "required": ["href"] },
                          { "properties": { "sourceRef": {} }, "required": ["sourceRef"] },
                          { "properties": { "topicId": {} }, "required": ["topicId"] }
                        ]
                      }
                    },
                    "tools": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["searchLabel", "filterColumn", "filterLabel", "itemLabel"],
                      "properties": {
                        "searchLabel": { "type": "string", "minLength": 1 },
                        "filterColumn": { "type": "integer", "minimum": 0 },
                        "filterLabel": { "type": "string", "minLength": 1 },
                        "itemLabel": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              ]
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "basis": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "catalog": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "domains",
              "aliases",
              "revision",
              "applicability",
              "limits",
              "sourceStatus",
              "reviewedOn",
              "claims"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "concept",
                  "capability",
                  "technology",
                  "practice",
                  "example",
                  "reference",
                  "procedure"
                ]
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "uniqueItems": true
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "applicability": {
                "type": "string",
                "minLength": 1
              },
              "limits": {
                "type": "string",
                "minLength": 1
              },
              "sourceStatus": {
                "enum": [
                  "legacy",
                  "reviewed",
                  "needs-review"
                ]
              },
              "reviewedOn": {
                "type": "string",
                "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sectionLabel",
                    "text",
                    "sourceRefs"
                  ],
                  "properties": {
                    "sectionLabel": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "basisKinds",
                  "confidenceLevel"
                ],
                "properties": {
                  "basisKinds": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "documented",
                        "proposed",
                        "inspected",
                        "recommended",
                        "research",
                        "illustrative",
                        "supplied"
                      ]
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  },
                  "confidenceLevel": {
                    "enum": [
                      "established",
                      "proposed",
                      "speculative"
                    ]
                  }
                }
              },
              "applies": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "stages": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "uniqueItems": true
                  },
                  "recipes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "uniqueItems": true
                  },
                  "technologies": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "uniqueItems": true
                  },
                  "hosts": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "uniqueItems": true
                  }
                }
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "generality"
                ],
                "properties": {
                  "generality": {
                    "enum": [
                      "general",
                      "example"
                    ]
                  },
                  "context": {
                    "enum": [
                      "atlassian-jenkins",
                      "neptune-rdf",
                      "talos",
                      "country-data",
                      "configuration-study",
                      "jev-typesafe",
                      "copilot"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
